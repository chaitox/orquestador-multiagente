# ---------------------------------------------------------------
# Orquestador multi-agente — variables de entorno
# Todas son OPCIONALES: sin este archivo el orquestador funciona.
# ---------------------------------------------------------------

# Autenticación
# Dejalo comentado para usar tu plan Max vía el login de Claude Code.
# Descomentalo solo si querés facturar por API.
# ANTHROPIC_API_KEY=

# Rutas
# Sirve si no querés hardcodear las rutas en proyectos/<nombre>.ts.
# En el config se usa así:  raiz: "${DEV_HOME}/mi-proyecto"
# DEV_HOME=

# Telegram
# Solo si ponés canal: "telegram" o "ambos" en preguntas del config.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#Grupo con topics: un hilo por agente (id=message_thread_id)
# TELEGRAM_TOPICS=spec=2,api=5,web=8,flutter=10,python=12,plsql=14
