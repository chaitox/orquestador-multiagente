{
  "name": "orquestador-agentes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Orquestador multi-agente configurable por proyecto sobre el Claude Agent SDK",
  "scripts": {
    "tarea": "tsx src/index.ts",
